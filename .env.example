# MiroFish stable fork example environment.
# Copy to .env and fill only the providers/features you plan to use.

# Backend/frontend
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
FRONTEND_PORT=3000
ALLOW_UNCONFIGURED_STARTUP=true
VITE_OPEN_BROWSER=true
SECRET_KEY=change-me-before-shared-deployment
DATA_DIR=./backend/data
UPLOAD_FOLDER=./backend/uploads

# Default OpenAI-compatible LLM used by generation/report flows.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: isolate the interactive OASIS simulation subprocess from the
# default graph/report/profile model.
SIMULATION_LLM_API_KEY=
SIMULATION_LLM_BASE_URL=
SIMULATION_LLM_MODEL_NAME=

# Optional providers used by model maps.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Example S2/S3 model ids.
QWEN_MODEL=qwen/qwen3-8b
GEMMA_MODEL=google/gemma-3-27b-it
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Graph/memory backends.
GRAPH_BACKEND=graphiti
# Native/source execution connects through the host-published Neo4j port.
GRAPHITI_URI=bolt://localhost:7687
# Compose overrides GRAPHITI_URI inside MiroFish with this service-network URI.
DOCKER_GRAPHITI_URI=bolt://neo4j:7687
GRAPHITI_USER=neo4j
GRAPHITI_PASSWORD=mirofishpassword
GRAPHITI_DATABASE=neo4j
GRAPHITI_BYPASS_NODE_DEDUP=true
USE_EXPERIMENTAL_MEMORY=false

# Worldbuilding trace capture. Raw artifacts stay disabled in the stable fork.
PLANNING_CAPTURE_ENABLED=true
PLANNING_CAPTURE_MODE=capture_only
PLANNING_CAPTURE_SAVE_RAW_ARTIFACTS=false
PLANNING_CAPTURE_REDACT_SECRETS=true

# Graphiti LLM/embedding/rerank settings. Leave blank to reuse LLM_* where
# supported by the code path.
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_BASE_URL=
GRAPHITI_LLM_MODEL=
GRAPHITI_LLM_CLIENT_MODE=generic
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDER_BASE_URL=
GRAPHITI_EMBEDDER_MODEL=
GRAPHITI_EMBEDDER_DIM=1024
GRAPHITI_RERANKER_API_KEY=
GRAPHITI_RERANKER_BASE_URL=
GRAPHITI_RERANKER_MODEL=

# Optional limits for a low-cost real ReportAgent smoke. Production defaults
# are 5 tool calls/subqueries and 2 reflection rounds when omitted.
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_SUB_QUERIES=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2

# Zep is optional; leave blank unless using Zep-backed memory.
ZEP_API_KEY=

# MiroFish stable fork example environment.
# Copy to .env and fill only the providers/features you plan to use.

# Backend/frontend
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
FRONTEND_PORT=3000
ALLOW_UNCONFIGURED_STARTUP=true
VITE_OPEN_BROWSER=true
SECRET_KEY=change-me-before-shared-deployment
DATA_DIR=./backend/data
UPLOAD_FOLDER=./backend/uploads

# Default OpenAI-compatible LLM used by generation/report flows.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional fallback LLM used when the primary LLM fails or returns invalid
# structured output. Leave blank to disable cascading fallback.
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=

# Optional: isolate the interactive OASIS simulation subprocess from the
# default graph/report/profile model.
SIMULATION_LLM_API_KEY=
SIMULATION_LLM_BASE_URL=
SIMULATION_LLM_MODEL_NAME=

# Simulation model routing + telemetry. Enable this to write
# model_routing_audit.jsonl and llm_telemetry.jsonl for new simulation runs.
# Leave SIMULATION_MODEL_MAP_PATH blank to use configs/model_map_openrouter.yaml.
# If using the bundled OpenRouter map, point LLM_API_KEY/LLM_BASE_URL at
# OpenRouter, for example LLM_BASE_URL=https://openrouter.ai/api/v1.
ENABLE_SIMULATION_MODEL_ROUTING=true
SIMULATION_MODEL_MAP_PATH=
OASIS_DEFAULT_MAX_ROUNDS=10

# Optional providers used by model maps.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
GEMINI_API_KEY=

# Optional grounded web research prepended to the simulation seed.
# Keep disabled unless TAVILY_API_KEY is configured; otherwise the service
# falls back to the LLM's internal knowledge instead of searching the web.
ENABLE_DEEP_SEARCH=false
DEEP_SEARCH_PROVIDER=tavily
DEEP_SEARCH_API_KEY=
TAVILY_API_KEY=

# Example S2/S3 model ids.
QWEN_MODEL=qwen/qwen3-8b
GEMMA_MODEL=google/gemma-3-27b-it
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Graph/memory backends.
GRAPH_BACKEND=graphiti
GRAPH_SEARCH_RERANKER=rrf
GRAPH_SEARCH_APP_RERANKER=embedding_rrf
GRAPH_SEARCH_APP_SEMANTIC_WEIGHT=2.0
GRAPH_SEARCH_APP_EMBEDDER_API_KEY=
GRAPH_SEARCH_APP_EMBEDDER_BASE_URL=
GRAPH_SEARCH_APP_EMBEDDER_MODEL=
GRAPH_SEARCH_APP_RERANKER_API_KEY=
GRAPH_SEARCH_APP_RERANKER_BASE_URL=
GRAPH_SEARCH_APP_RERANKER_MODEL=
GRAPH_SEARCH_APP_RERANKER_PROVIDER=auto
GRAPH_SEARCH_INCLUDE_NODES=true
GRAPH_SEARCH_EXPAND_EDGES_FROM_NODES=true
# Native/source execution connects through the host-published Neo4j port.
GRAPHITI_URI=bolt://localhost:7687
# Compose overrides GRAPHITI_URI inside MiroFish with this service-network URI.
DOCKER_GRAPHITI_URI=bolt://neo4j:7687
GRAPHITI_USER=neo4j
GRAPHITI_PASSWORD=mirofishpassword
GRAPHITI_DATABASE=neo4j
GRAPHITI_BYPASS_NODE_DEDUP=true
USE_EXPERIMENTAL_MEMORY=false

# Worldbuilding trace capture. Raw artifacts stay disabled in the stable fork.
PLANNING_CAPTURE_ENABLED=true
PLANNING_CAPTURE_MODE=capture_only
PLANNING_CAPTURE_SAVE_RAW_ARTIFACTS=false
PLANNING_CAPTURE_REDACT_SECRETS=true

# Graphiti LLM/embedding/rerank settings. Leave blank to reuse LLM_* where
# supported by the code path.
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_BASE_URL=
GRAPHITI_LLM_MODEL=
GRAPHITI_LLM_SMALL_MODEL=
GRAPHITI_LLM_CLIENT_MODE=generic
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDER_BASE_URL=
GRAPHITI_EMBEDDER_MODEL=
GRAPHITI_EMBEDDER_DIM=1024
GRAPHITI_RERANKER_API_KEY=
GRAPHITI_RERANKER_BASE_URL=
GRAPHITI_RERANKER_MODEL=
GRAPHITI_ENABLE_CROSS_ENCODER=false
GRAPHITI_MAX_COROUTINES=20

# Optional limits for a low-cost real ReportAgent smoke. Production defaults
# are 5 tool calls/subqueries and 2 reflection rounds when omitted.
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_SUB_QUERIES=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
ENABLE_FUSION_VERDICT=true
FUSION_VERDICT_MODEL=openai/gpt-4o-mini
FUSION_VERDICT_MAX_REPORT_CHARS=12000
FUSION_VERDICT_TIMEOUT_SECONDS=20

# Zep is optional; leave blank unless using Zep-backed memory.
ZEP_MODE=cloud
ZEP_API_KEY=
ZEP_BASE_URL=
OPENZEP_EMBEDDER_API_KEY=
OPENZEP_EMBEDDER_BASE_URL=
OPENZEP_EMBEDDER_MODEL=

# Similarity cutoff for deduplication/memory experiments.
SIMILARITY_THRESHOLD=0.85
